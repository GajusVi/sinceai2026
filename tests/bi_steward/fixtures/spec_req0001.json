  "measures": [
    {
      "name": "Net Sales",
      "kpi_id": "KPI-001",
      "expression": "SUM(fact_pmm[net_sales_m_eur_syn])",
      "format": "EUR M",
      "unit": "EUR",
      "source": "fact_pmm.net_sales_m_eur_syn",
      "aggregation": "sum",
      "definition_status": "canonical",
      "feasible": true,
      "gap_reason": ""
    },
    {
      "name": "Net Sales Growth",
      "kpi_id": "KPI-004",
      "expression": "VAR cur = MAX(dim_month[month]) VAR cur_sales = CALCULATE(SUM(fact_pmm[net_sales_m_eur_syn]), dim_month[month] = cur) VAR prior_sales = CALCULATE(SUM(fact_pmm[net_sales_m_eur_syn]), dim_month[month] = EDATE(cur, -1)) RETURN DIVIDE(cur_sales - prior_sales, prior_sales)",
      "format": "0.0%",
      "unit": "%",
      "source": "derived",
      "aggregation": "derived",
      "definition_status": "canonical",
      "feasible": true,
      "gap_reason": ""
    },
    {
      "name": "Forecast Variance",
      "kpi_id": "KPI-042",
      "expression": "SUM(fact_pmm[net_sales_m_eur_syn]) - SUM(fact_pmm[forecast_m_eur_syn])",
      "format": "EUR M",
      "unit": "EUR",
      "source": "derived",
      "aggregation": "derived",
      "definition_status": "canonical",
      "feasible": true,
      "gap_reason": ""
    },
    {
      "name": "Market Access Coverage",
      "kpi_id": "KPI-027",
      "expression": "CALCULATE(AVERAGE(fact_pmm[market_access_coverage_pct_syn]), fact_pmm[net_sales_m_eur_syn] > 0)",
      "format": "0.0",
      "unit": "%",
      "source": "fact_pmm.market_access_coverage_pct_syn",
      "aggregation": "avg",
      "definition_status": "canonical",
      "feasible": true,
      "gap_reason": ""
    }
  ],
