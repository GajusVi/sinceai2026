#!/bin/sh
# Runs the offline smoke tests before every push, so nobody breaks main for the other three.
# Takes ~10 s, needs no API key. Emergency only (tell the team): git push --no-verify
root=$(git rev-parse --show-toplevel)
if [ -x "$root/.venv/bin/python" ]; then py="$root/.venv/bin/python"
elif [ -x "$root/.venv/Scripts/python.exe" ]; then py="$root/.venv/Scripts/python.exe"
else echo "pre-push: no .venv found, tests skipped (run the setup script)"; exit 0; fi
echo "pre-push: running smoke tests..."
cd "$root" && DEMO_MODE=1 PYTHONUTF8=1 "$py" -m pytest -q -x -p no:cacheprovider tests
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: tests failed, push refused. Fix them (or ask Claude Code to), then push again."
  exit 1
fi
exit 0
