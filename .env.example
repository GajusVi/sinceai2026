# Copy to .env (setup_mac.sh does this) and fill in ONE provider's key.
# Switch provider with one line. Model defaults: anthropic=claude-sonnet-5-5, aitta=meta-llama/Llama-3.3-70B-Instruct, gemini=gemini-3.5-flash
LLM_PROVIDER=gemini          # gemini | aitta | anthropic | openai | featherless | ollama
LLM_MODEL=                     # blank: the *_MODEL line below for the active provider is used
# LLM_BASE_URL=                 # only for a provider not listed above (any OpenAI-compatible URL)

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AITTA_API_KEY=                  # token from https://aitta-auth.csc.fi/myToken (needs an active LUMI project)

FEATHERLESS_API_KEY=            # Since AI benefit: $25 credit, open-weight models (claim early)
GEMINI_API_KEY=                 # Google AI Studio key; using Gemini qualifies for MLH 'Best Use of Gemini API'

# BI Steward (steward/). Uses ANTHROPIC_API_KEY or GEMINI_API_KEY above; no key = rules + templates.
STEWARD_LLM_PROVIDER=auto       # auto | claude | gemini   (gemini also needs: uv pip install google-genai)
STEWARD_USE_LLM=auto            # off = force rules + templates (stage-safe)
STEWARD_LLM_MODEL=              # blank = claude-haiku-5-5 / gemini-2.5-flash
STEWARD_AS_OF=2026-11-06        # fixed "today" for freshness checks

# Team board: optional Discord mirror of coord messages (channel settings > Integrations > Webhooks)
COORD_DISCORD_WEBHOOK=

DEMO_MODE=0                     # 1 = replay demo/cache, no network. Use on stage.
# USER_ROLE is set in backend/config.py, not here: it is part of the demo-cache key,
# so every laptop must use the same value. Change it in code on Friday.

# Data APIs (Turku Energia backup data)
ENTSOE_API_KEY=                 # ENTSO-E Transparency token (requested 5 Nov, approval <= 3 working days)
FINGRID_API_KEY=                # data.fingrid.fi

# Model per provider (switch with LLM_PROVIDER only)
GEMINI_MODEL=gemini-3.5-flash
AITTA_MODEL=meta-llama/Llama-3.3-70B-Instruct
